{
  "name": "flowery-bot",
  "version": "1.0.0",
  "description": "Discord voice bot that listens for wake words and replies with Flowery voice lines",
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "download-model": "node scripts/download-model.mjs",
    "test-stt": "tsx scripts/test-stt.ts",
    "download-voicelines": "node scripts/download-voicelines.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^1.30.0",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "ffmpeg-static": "^5.3.0",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "sherpa-onnx-node": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.12"
  }
}
