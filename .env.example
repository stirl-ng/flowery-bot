# Required: bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: register slash commands to one server instantly (otherwise global, can take up to an hour)
GUILD_ID=

# Comma-separated wake words / phrases. Matching is fuzzy and ignores spaces.
WAKE_WORDS=flowery

# 0..1 — how close a transcript chunk must be to a wake word. Lower = more triggers, more false positives.
# 0.9 keeps "flower"/"flowers" from triggering "flowery". For made-up names the recognizer
# mangles (e.g. "flowerman" → "flow erman"), try 0.8.
WAKE_WORD_THRESHOLD=0.9

# How long someone must be silent before their utterance is transcribed (ms).
SILENCE_MS=600

# Pause after a reply finishes before Flowery replies again (ms).
COOLDOWN_MS=1500

# Folder of voice line audio files (mp3, wav, ogg, opus, m4a, flac).
# voicelines/clean = de-bitcrushed, voicelines/original = as in game (bitcrushed).
VOICELINES_DIR=voicelines/clean

# Phrase → specific clip mappings (checked before the wake word).
TRIGGERS_FILE=triggers.json

# After the wake word ("flowery, ___"), who picks the reply:
#   gemini = Google Gemini reads what was said and picks 1..MAX_CLIPS fitting clips (free tier available)
#   claude = same, using Claude (needs paid API credits)
#   random = a random clip (also the automatic fallback if the LLM errors or times out)
CLIP_PICKER=gemini
# Needed for CLIP_PICKER=gemini. Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Needed for CLIP_PICKER=claude. Get one at https://platform.claude.com/
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low = fastest replies; medium/high think longer before picking.
CLAUDE_EFFORT=low
MAX_CLIPS=3


# Folder with the sherpa-onnx speech model (see `npm run download-model`).
MODEL_DIR=models/sherpa-onnx-nemo-parakeet_tdt_transducer_110m-en-36000-int8

# Log every transcript to the console (handy for tuning wake words).
LOG_TRANSCRIPTS=true
